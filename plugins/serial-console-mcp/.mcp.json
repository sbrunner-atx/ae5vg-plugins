{
  "mcpServers": {
    "serial-console": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}/servers/serial-console",
        "serial-console-mcp"
      ],
      "env": {
        "SERIAL_CONSOLE_READ_ONLY": "${user_config.read_only}",
        "SERIAL_CONSOLE_IDLE_MINUTES": "${user_config.idle_minutes}"
      }
    }
  }
}
